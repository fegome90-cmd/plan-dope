{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write.*(_ctx/(plans|jobs|requirements)/.*\\.yaml)",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/lib/plan_validator.py \"${FILE_PATH}\" --schema requirement-set",
            "description": "Auto-validate planning YAML files (plans, jobs, requirements)",
            "timeout": 30,
            "failurePolicy": "fail"
          }
        ]
      }
    ]
  }
}
